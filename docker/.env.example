# ============================================================
#  CareerForge n8n — Environment Variables
#  Copy this file to .env and fill in your values
#  Run: docker compose up -d  (from the docker/ folder)
# ============================================================

# --- n8n Auth (change these) ---
N8N_USER=careerforge
N8N_PASSWORD=demo1234

# --- LLM via OpenRouter (https://openrouter.ai) ---
# All models route through here: claude-sonnet-4.6, gemini-flash, gpt-4.1-nano
OPENROUTER_API_KEY=sk-or-v1-...

# --- Supabase (https://supabase.com) ---
# Free tier is more than enough
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...

# --- Firecrawl (https://firecrawl.dev) ---
# Connect via n8n Admin Panel first to claim 100k free credits
# Then grab your API key from the Firecrawl dashboard
FIRECRAWL_API_KEY=fc-...

# --- Serper.dev (https://serper.dev) ---
# Used for news search in Company Intel (workflow 03)
# 2,500 free searches on signup
SERPER_API_KEY=...

# --- You.com Search API (https://you.com/platform) ---
# Free credits on signup, no credit card required
# Used for job search (workflow 02) and contact finding (workflow 03)
YOUCOM_API_KEY=...

# --- Telegram Bot ---
# Create a bot via @BotFather, get the token
# Get your chat ID by messaging @userinfobot
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# --- Optional: n8n URL config ---
# Change if running behind a reverse proxy or ngrok
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678
TIMEZONE=America/New_York
