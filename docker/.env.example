# ═══════════════════════════════════════════════════════════════
# CareerForge n8n — Environment Variables
# Copy to .env and fill in your values:  cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# --- n8n Auth (change these!) ---
N8N_USER=careerforge
N8N_PASSWORD=pick_a_password_here
N8N_ENCRYPTION_KEY=run_openssl_rand_hex_32_to_generate_this

# --- Public URL (for Telegram webhooks) ---
# Local dev with ngrok:  https://your-subdomain.ngrok-free.app
# Production:            https://your-domain.com
WEBHOOK_URL=https://your-subdomain.ngrok-free.app
N8N_HOST=your-subdomain.ngrok-free.app
N8N_PROTOCOL=https

# --- REQUIRED: OpenRouter ---
# Sign up: https://openrouter.ai/sign-up
# Do $10 deposit → unlocks 1000 :free model calls/day forever
# Keys: https://openrouter.ai/settings/keys → Create Key
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxx

# --- REQUIRED: Telegram Bot ---
# Message @BotFather → /newbot → follow prompts → get token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# --- REQUIRED for the Mini App (miniapp/): shared secret between the
# FastAPI sidecar and the "Bridge Snapshot" node in the master workflow.
# Generate with: openssl rand -hex 32
MINIAPP_BRIDGE_SECRET=

# --- REQUIRED: At least ONE search provider ---
# Firecrawl — Get via OpenRouter plugin: Settings → Plugins → Web Search
#   Accepts ToS → auto-creates Firecrawl account with 100K free credits
#   Then grab key from: https://firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=fc-xxxxxxxxxx

# You.com (optional) — Sign up: https://api.you.com (no credit card)
#   $100 free credits = ~20K searches. LiveCrawl included.
YOUCOM_API_KEY=

# Serper (optional) — Sign up: https://serper.dev/signup (no credit card)
#   2,500 one-time credits on signup. No monthly refresh.
SERPER_API_KEY=

# --- Timezone ---
TIMEZONE=America/New_York

# ═══════════════════════════════════════════════════════════════
# ATS ENGINE — job cache, embeddings, generation model, toggles
# All have safe local defaults in docker-compose.yml, so you only
# need to set these to override. (You.com is dropped from sourcing.)
# ═══════════════════════════════════════════════════════════════

# --- Postgres (job cache + pgvector) ---
# These must match the n8n "CareerForge Postgres" credential you create
# in the UI (host: postgres-service, port: 5432).
POSTGRES_USER=careerforge
POSTGRES_PASSWORD=cf_local_dev
POSTGRES_DB=careerforge
POSTGRES_HOST=postgres-service
POSTGRES_PORT=5432

# --- Ollama (local bge-m3 embeddings, 1024-d) ---
OLLAMA_URL=http://ollama-service:11434
EMBED_MODEL=bge-m3

# --- Generation LLM (single source of truth, via OpenRouter) ---
# Swap this one value to change every generation node (cover letters,
# résumé tailoring, intel, outreach). e.g. openai/gpt-5.4-mini,
# deepseek/deepseek-v4-flash, google/gemini-2.5-flash-lite (cheapest).
GEN_MODEL=google/gemini-3.5-flash

# --- ATS provider toggles (poller fan-out branches) ---
# Clean public APIs default ON; the scrape-tail (Firecrawl) defaults OFF
# until verified. Flip to enable/disable a branch — like the FC/Serper toggles.
ATS_GREENHOUSE_ENABLED=true
ATS_LEVER_ENABLED=true
ATS_ASHBY_ENABLED=true
ATS_WORKABLE_ENABLED=true
ATS_RECRUITEE_ENABLED=true
ATS_PERSONIO_ENABLED=true
ATS_SMARTRECRUITERS_ENABLED=true
ATS_WORKDAY_ENABLED=false
ATS_SCRAPE_ENABLED=false

# --- find_jobs: also run the old live FC/Serper web search and union
#     it into the cache results? Default OFF (cache is the source of truth). ---
LIVE_SEARCH_SUPPLEMENT=false
