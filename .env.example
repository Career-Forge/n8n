# ─────────────────────────────────────────────────────────────────────────────
# CareerForge n8n — environment template. Copy to `.env` and fill in.
# Self-hosted, clone-and-BYOK: every value below is YOUR own key/secret.
# See SETUP.md for what each unlocks (free tier vs premium) and where else keys go
# (some providers are configured in the n8n Credentials tab or the app_settings table,
# not here — SETUP.md spells out which).
# ─────────────────────────────────────────────────────────────────────────────

# ── n8n core ──
N8N_HOST=localhost
N8N_PROTOCOL=http
# Public HTTPS URL n8n is reachable at (e.g. your ngrok/Cloudflare/host URL).
# Telegram webhooks require HTTPS — for local dev, point this at your ngrok URL.
WEBHOOK_URL=http://localhost:5678
# Generate once: `openssl rand -hex 24` — DO NOT change after first run (encrypts stored credentials).
N8N_ENCRYPTION_KEY=
N8N_USER=careerforge
N8N_PASSWORD=change_me

# ── Required: LLM provider ──
# OpenRouter API key — powers every LLM role (resume, scoring, intel, outreach...).
# A ~$10 deposit lasts a long time at single-user volume. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Required: Telegram bot ──
# Create a bot with @BotFather, paste the token here.
TELEGRAM_BOT_TOKEN=

# ── Free-tier search providers (generous free credits; all optional but recommended) ──
# Serper  — 2,500 free credits.   https://serper.dev
SERPER_API_KEY=
# You.com — $100 free credits.    https://api.you.com
YOUCOM_API_KEY=
# Firecrawl — 500 free credits/mo. https://firecrawl.dev
FIRECRAWL_API_KEY=

# ── Postgres (pgvector) ──
POSTGRES_USER=careerforge
POSTGRES_PASSWORD=change_me
POSTGRES_DB=careerforge

# ── Ollama (local embeddings, free) ──
OLLAMA_URL=http://ollama-service:11434

# ─────────────────────────────────────────────────────────────────────────────
# NOT set here (see SETUP.md):
#   - Adzuna app_id/app_key  -> app_settings table (free structured job lane)
#   - Telegraph token        -> app_settings table (auto-created on first run)
#   - Apollo / Hunter        -> n8n Credentials tab + app_settings enable flags (premium contacts, OFF by default)
# ─────────────────────────────────────────────────────────────────────────────
