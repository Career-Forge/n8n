# Environment & secrets
.env
.env.local
.env.*
!.env.example

# Archive (legacy workflows, old docs, deprecated services)
bak/

# User data (contains PII)
user-data/
data/user-data/

# Dead config (ATS slugs no longer used — pipeline is fully dynamic)
data/companies.json

# Claude Code artifacts (local dev only)
.claude/

# Local review notes
Review.md

# Debug aggregate test fixture (large JSON dump, not useful in repo)
Aggregate_Results.md

# Matcher dev test fixtures (contain sample resume text / PII) + model cache
services/matcher/_test_*.json
services/matcher/_test_*.py
services/matcher/_discover_*.py
services/matcher/data/
services/matcher/.hf/

# Workflow patch backups (s14/s15/p0/etc. safety copies — not committed)
docker/workflows/*.s1*bak-*
workflows/*.s1*bak-*
docker/workflows/*.p0bak-*
workflows/*.p0bak-*
docker/workflows/*.p2bak-*
workflows/*.p2bak-*

# n8n runtime databases (Docker volume data)
*.sqlite
*.sqlite-journal
*.db

# Debug SQL queries
docker/query*.sql
docker/qlatest.sql

# Connection extracts (debug artifacts)
connections_extract.json

# Node
node_modules/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Build artifacts
dist/
build/

# GeoNames raw dumps (the generated db/seed_geonames.sql IS committed; the
# multi-MB source .txt/.zip are not — regenerate via scripts/gen_geonames_seed.js)
db/geonames/

# Local patch scripts (we only commit the resulting JSON, not the patchers)
scripts/patch_workflow*.py

# Workflow backups (the script creates these as safety, no need to commit)
workflows/*.backup*.json

# harness scratch output
scripts/_tmp_s6b1/
