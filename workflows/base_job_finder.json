{
  "name": "Advanced Pipeline: Base Job Finder (ForgeScore)",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Start Job Search",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "fileSelector": "d:/My-Projects/Career_Forge_Development/careerforge_n8n/storage/master_resume/master_resume.txt",
        "outputKey": "resumeContent",
        "options": {}
      },
      "id": "read_resume",
      "name": "Read Master Resume",
      "type": "n8n-nodes-base.readFiles",
      "typeVersion": 1,
      "position": [220, 0]
    },
    {
      "parameters": {
        "text": "Analyze the following Master Resume and perform weighted analytics heavily prioritizing the most recent experiences. Output the single top target Job Title and ideal Location.\n\n## RESUME\n{{ $json.resumeContent }}"
      },
      "id": "stage_1_strategist",
      "name": "Stage 1: Role Generator",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [440, 0]
    },
    {
      "parameters": {
        "model": "google/gemini-3-flash-preview",
        "options": {}
      },
      "id": "model_gemini",
      "name": "Gemini-3-Flash (BYOK)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [440, 200]
    },
    {
      "parameters": {
        "text": "=You are an expert Job Scraper with web access.\nA user has been targeted for the following career profile: {{ $json.text }}.\n\nUsing your native OpenRouter Web Search capabilities, search EXACTLY these tracking sites:\nsite:boards.greenhouse.io OR site:jobs.lever.co OR site:jobs.ashbyhq.com OR site:boards.workable.com.\n\nFilter results for jobs posted strictly in the PAST 24 HOURS.\nFetch the content from the top 10 relevant job URLs and output their JD text.",
        "options": {}
      },
      "id": "stage_2_hunter",
      "name": "Stage 2: Job Hunter Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [880, 0]
    },
    {
      "parameters": {
        "model": "openai/gpt-5.4-mini",
        "options": {}
      },
      "id": "model_agent",
      "name": "Hunter Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [880, 200]
    },
    {
      "parameters": {
        "text": "=Execute the 100-point ForgeScore algorithm against the jobs found compared to the Master Resume.\n\n## MASTER RESUME:\n{{ $('Read Master Resume').item.json.resumeContent }}\n\n## SCRAPED JOBS:\n{{ $json.output }}\n\nOutput a JSON array calculating technicalSkills, experience, education, projects, strengths, gaps, and an overallScore (0-100) for each job. Only recommend jobs scoring > 75%.\n",
        "options": {}
      },
      "id": "stage_3_forgescore",
      "name": "Stage 3: ForgeScore Evaluator",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [1320, 0]
    },
    {
      "parameters": {
        "model": "openai/gpt-5.4",
        "options": {}
      },
      "id": "model_forgescore",
      "name": "Evaluator Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [1320, 200]
    }
  ],
  "connections": {
    "Start Job Search": {
      "main": [
        [
          {
            "node": "Read Master Resume",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Master Resume": {
      "main": [
        [
          {
            "node": "Stage 1: Role Generator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini-3-Flash (BYOK)": {
      "ai_languageModel": [
        [
          {
            "node": "Stage 1: Role Generator",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Stage 1: Role Generator": {
      "main": [
        [
          {
            "node": "Stage 2: Job Hunter Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Hunter Model": {
      "ai_languageModel": [
        [
          {
            "node": "Stage 2: Job Hunter Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Stage 2: Job Hunter Agent": {
      "main": [
        [
          {
            "node": "Stage 3: ForgeScore Evaluator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evaluator Model": {
      "ai_languageModel": [
        [
          {
            "node": "Stage 3: ForgeScore Evaluator",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
