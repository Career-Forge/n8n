    {
      "parameters": {
        "chatId": "={{ $('Extract Input').item.json.chat_id || $('Schedule Payload').item.json.chat_id }}",
        "text": "👋 *CareerForge — Your AI Job Hunt Assistant*\n\nHere's what I can do:\n\n🔍 *Find Jobs* — \"find ML jobs in NYC\"\n📄 *Apply* — reply with a job number (e.g. \"3\") to generate a tailored resume + cover letter\n✏️ *Revise* — \"make it shorter\" / \"add more Python\"\n📊 *Score* — \"score my resume\" for a fit check\n🏢 *Company Intel* — \"tell me about Anthropic\"\n📧 *Outreach* — \"find recruiters at Scale AI\"\n💰 *Salary* — \"salary for ML Engineer at Google\"\n📋 *Track* — \"track this application\"\n📁 *Status* — \"show my applications\"\n\nJust type naturally — I'll figure out what you need!",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "cf-011",
      "name": "Send Help",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1320, 60],
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_CREDENTIAL_ID",
          "name": "CareerForge Bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Hardcoded company list for Greenhouse API\nconst companies = [\n  'anthropic',\n  'openai',\n  'databricks',\n  'huggingface',\n  'cohere',\n  'scale',\n  'adept',\n  'perplexity',\n  'mistral',\n  'together',\n  'replicate',\n  'runwayml',\n  'character-ai',\n  'elevenlabs',\n  'midjourney'\n];\n\nreturn companies.map(slug => ({\n  json: { company_slug: slug }\n}));"
      },
      "id": "cf-020",
      "name": "Company List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 340]
    },
    {
      "parameters": {
        "url": "=https://boards-api.greenhouse.io/v1/boards/{{ $json.company_slug }}/jobs",
        "options": {
          "timeout": 15000,
          "batching": {
            "batch": {
              "batchSize": 5,
              "batchInterval": 1000
            }
          }
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "true"
            }
          ]
        },
        "retry": {
          "maxRetries": 3,
          "retryInterval": 5000
        }
      },
      "id": "cf-021",
      "name": "Fetch Greenhouse Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 340],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Aggregate, filter by keywords, dedupe, take top 20 by recency\nconst allJobs = [];\nconst seen = new Set();\n\n// Role keywords to filter (broad ML/AI/Software match)\nconst keywords = [\n  'engineer', 'developer', 'scientist', 'researcher',\n  'machine learning', 'ml ', 'ai ', 'data', 'backend',\n  'software', 'infrastructure', 'platform', 'systems',\n  'fullstack', 'full-stack', 'full stack', 'applied',\n  'nlp', 'retrieval', 'search', 'python', 'deep learning'\n];\n\nfor (const item of $input.all()) {\n  const jobs = item.json.jobs || [];\n  const companySlug = item.json.company_slug || 'unknown';\n\n  for (const job of jobs) {\n    if (!job || !job.id) continue;\n\n    const dedupKey = `${job.id}`;\n    if (seen.has(dedupKey)) continue;\n    seen.add(dedupKey);\n\n    const title = (job.title || '').toLowerCase();\n    const dept = ((job.departments || [])[0]?.name || '').toLowerCase();\n    const combined = `${title} ${dept}`;\n\n    // Check if job matches any keyword\n    const matches = keywords.some(kw => combined.includes(kw));\n    if (!matches) continue;\n\n    const location = (job.location?.name || 'Unknown');\n\n    allJobs.push({\n      job_id: `${companySlug}-${job.id}`,\n      title: job.title,\n      company: companySlug,\n      location: location,\n      department: (job.departments || [])[0]?.name || '',\n      url: job.absolute_url || `https://boards.greenhouse.io/${companySlug}/jobs/${job.id}`,\n      updated_at: job.updated_at || '1970-01-01',\n      description_snippet: (job.content || '').replace(/<[^>]*>/g, '').substring(0, 300)\n    });\n  }\n}\n\n// Sort by updated_at desc (most recent first), take top 20\nallJobs.sort((a, b) => new Date(b.updated_at) - new Date(a.updated_at));\nconst top20 = allJobs.slice(0, 20);\n\nreturn [{ json: { jobs: top20, count: top20.length } }];"
      },
      "id": "cf-022",
      "name": "Aggregate Jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 340]
    },
    {
      "parameters": {
        "filePath": "/data/user-data/master_resume.txt"
      },
      "id": "cf-023",
      "name": "Read Resume",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [1980, 340]
    },
    {
      "parameters": {
        "jsCode": "// Build the scorer input: resume summary + jobs batch\nconst jobs = $('Aggregate Jobs').first().json.jobs;\nconst resumeBinary = $('Read Resume').first().binary;\n\n// Extract resume text from binary data\nlet resumeText = '';\nif (resumeBinary && resumeBinary.data) {\n  resumeText = Buffer.from(resumeBinary.data.data, 'base64').toString('utf-8');\n} else {\n  resumeText = $('Read Resume').first().json.data || 'No resume found';\n}\n\n// Build a condensed summary for the scorer (first 2000 chars)\nconst masterResumeSummary = resumeText.substring(0, 2000);\n\nconst jobBatch = jobs.map(j => ({\n  job_id: j.job_id,\n  title: j.title,\n  company: j.company,\n  location: j.location,\n  department: j.department,\n  url: j.url,\n  description_snippet: j.description_snippet\n}));\n\nreturn [{\n  json: {\n    master_resume_summary: masterResumeSummary,\n    jobs: jobBatch\n  }\n}];"
      },
      "id": "cf-024",
      "name": "Build Scorer Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2200, 340]
    },
    {
      "parameters": {
        "prompt": "=You are a lightweight job-ranking engine. You receive a candidate's master resume summary and a batch of job listings, then score each job's fit on a 0-10 scale with a one-line reason.\n\nReturn strict JSON only — no markdown fencing, no commentary, no preamble.\n\nOutput schema:\n{\"scored\":[{\"job_id\":\"string\",\"fit_score\":integer 0-10,\"one_liner\":\"under 80 chars\"}]}\n\nScoring criteria:\n- Skills overlap: candidate skills vs job requirements\n- Role alignment: title/department vs candidate's experience\n- Location match: candidate's location or remote\n- Seniority fit: experience level alignment\n\nCalibration:\n- 8-10: Strong match\n- 6-7: Good match\n- 4-5: Partial\n- 1-3: Weak\n- 0: Complete mismatch\n\none_liner format: Start with \"Strong fit\", \"Good fit\", \"Partial\", \"Weak\", or \"Mismatch\" + dash + top reasons.\n\nReturn scored array sorted by fit_score descending.\n\n---\n\nCandidate Resume Summary:\n{{ $json.master_resume_summary }}\n\nJobs to Score:\n{{ JSON.stringify($json.jobs) }}"
      },
      "id": "cf-025",
      "name": "JobScorer",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [2420, 340]
    },
    {
      "parameters": {
        "model": "google/gemini-3-flash-lite",
        "options": {
          "baseURL": "https://openrouter.ai/api/v1",
          "temperature": 0
        }
      },
      "id": "cf-026",
      "name": "OpenRouter LLM (Scorer)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [2360, 560],
      "credentials": {
        "openAiApi": {
          "id": "OPENROUTER_CREDENTIAL_ID",
          "name": "OpenRouter API"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"scored\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"job_id\": { \"type\": \"string\" },\n          \"fit_score\": { \"type\": \"integer\" },\n          \"one_liner\": { \"type\": \"string\" }\n        },\n        \"required\": [\"job_id\", \"fit_score\", \"one_liner\"]\n      }\n    }\n  },\n  \"required\": [\"scored\"]\n}"
      },
      "id": "cf-027",
      "name": "Scorer Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [2500, 560]
    },
    {
      "parameters": {
        "jsCode": "// Format top 5 scored jobs as Telegram message + store in static data\nconst scorerOutput = $input.first().json.output || $input.first().json;\nconst scored = scorerOutput.scored || [];\nconst allJobs = $('Aggregate Jobs').first().json.jobs;\n\n// Take top 5\nconst top5 = scored.slice(0, 5);\n\n// Build lookup map\nconst jobMap = {};\nfor (const j of allJobs) {\n  jobMap[j.job_id] = j;\n}\n\n// Store in workflow static data for /apply N reference\nconst staticData = $getWorkflowStaticData('global');\nstaticData.last_jobs = {};\n\n// Format Telegram message\nlet msg = '🔍 *Top Job Matches*\\n\\n';\n\ntop5.forEach((s, i) => {\n  const num = i + 1;\n  const job = jobMap[s.job_id] || {};\n  const title = job.title || 'Unknown';\n  const company = (job.company || 'unknown').replace(/-/g, ' ');\n  const location = job.location || 'Unknown';\n  const score = s.fit_score;\n  const liner = s.one_liner;\n  const url = job.url || '';\n\n  // Store for later /apply N\n  staticData.last_jobs[num] = {\n    job_id: s.job_id,\n    title: title,\n    company: company,\n    location: location,\n    url: url,\n    fit_score: score,\n    description_snippet: job.description_snippet || ''\n  };\n\n  msg += `*${num}.* [${title}](${url})\\n`;\n  msg += `    🏢 ${company} · 📍 ${location}\\n`;\n  msg += `    📊 Fit: ${score}/10 — ${liner}\\n\\n`;\n});\n\nmsg += '_Reply with a number (1-5) to generate a tailored resume._';\n\nreturn [{ json: { message: msg } }];"
      },
