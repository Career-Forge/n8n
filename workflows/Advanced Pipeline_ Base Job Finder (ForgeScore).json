    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a ForgeScore Evaluator. Execute a 100-point scoring algorithm to evaluate how well each job matches the candidate's resume.\n\n## SCORING BREAKDOWN:\n- Technical Skills (0-40): Match required tech stack, tools, languages\n- Experience (0-30): Match years, seniority level, domain experience\n- Education (0-15): Match degree requirements, certifications\n- Projects (0-15): Match relevant project work, achievements\n\n## MASTER RESUME:\n{{ $('Merge').item.json.data }}\n\n## SCRAPED JOBS:\n{{ $json.output }}\n\n## OUTPUT FORMAT:\nReturn a JSON array of objects, each with:\n- jobTitle, company, jobUrl\n- overallScore (0-100)\n- breakdown: { technicalSkills, experience, education, projects }\n- strengths: [top 3 strengths]\n- gaps: [top 3 gaps]\n- recommendation: 'STRONG MATCH' | 'GOOD MATCH' | 'WEAK MATCH'\n\nOnly include jobs scoring >= 50. Sort by overallScore descending."
      },
      "id": "1098d837-4724-47e3-8cf8-ff950b57f1be",
      "name": "Stage 3: ForgeScore Evaluator",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        1232,
        0
      ]
    },
    {
      "parameters": {
        "model": "google/gemini-3.1-pro-preview",
        "options": {}
      },
      "id": "d92fc074-cbbd-422e-81f1-33e7ab459b75",
      "name": "Evaluator Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        1232,
        192
      ],
      "credentials": {
        "openRouterApi": {
          "id": "3Iip0FV9B9KVZMdc",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse the ForgeScore output into structured items\nconst rawText = $input.first().json.text || $input.first().json.output || '';\n\n// Try to extract JSON array from the response\nlet jobs = [];\ntry {\n  // Look for JSON array in the response\n  const jsonMatch = rawText.match(/\\[\\s*\\{[\\s\\S]*\\}\\s*\\]/);\n  if (jsonMatch) {\n    jobs = JSON.parse(jsonMatch[0]);\n  } else {\n    // If no JSON array found, wrap the raw text as a single result\n    jobs = [{ rawOutput: rawText, parsedAt: new Date().toISOString() }];\n  }\n} catch (e) {\n  jobs = [{ rawOutput: rawText, parseError: e.message, parsedAt: new Date().toISOString() }];\n}\n\n// Add timestamp to each job\nconst timestamp = new Date().toISOString();\nreturn jobs.map(job => ({\n  json: {\n    ...job,\n    scannedAt: timestamp\n  }\n}));"
      },
